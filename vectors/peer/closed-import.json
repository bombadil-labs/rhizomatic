  "invalidCases": [
    {
      "name": "copied host arrivals cannot be local import testimony",
      "mutation": "nonempty-local",
      "baseCase": 0,
      "expected": "local candidate is not empty"
    },
    {
      "name": "old and new peer identities must differ",
      "mutation": "same-peer",
      "baseCase": 0,
      "expected": "invalid attempt or policy descriptor"
    },
    {
      "name": "policy bytes must be present",
      "mutation": "missing-policy",
      "baseCase": 0,
      "expected": "invalid attempt or policy descriptor"
    },
    {
      "name": "old state version must be a safe counter",
      "mutation": "unsafe-version",
      "baseCase": 0,
      "expected": "invalid attempt or policy descriptor"
    },
    {
      "name": "obligation cannot use a different refusal snapshot",
      "mutation": "stale-obligation",
      "baseCase": 2,
      "expected": "invalid active obligation"
    }
  ],
  "stageCases": [
    {
      "name": "valid independent recovery permits one stage",
