      },
      "expectedView": {
        "icon": [
          {
            "mime": "image/png",
            "value": "iVBORw0KGgo"
          },
          {
            "mime": "application/wasm",
            "value": "iVBORw0KGgo"
          }
        ],
        "weight": 3,
        "stamp": 2
      },
      "expectedCanonicalHex": "a36469636f6e82a2646d696d6569696d6167652f706e676576616c75654889504e470d0a1a0aa2646d696d65706170706c69636174696f6e2f7761736d6576616c75654889504e470d0a1a0a657374616d70f9400066776569676874f94200"
    },
    {
      "name": "merge-sum-transparent-to-bytes",
      "spec": "SPEC-5 §3 (bytes are transparent to merge folds: sum sees only the numeric candidates)",
      "note": "weight: 2 + 3 = 5; the bytes candidate is skipped, not an error",
