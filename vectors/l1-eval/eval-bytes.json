    {
      "name": "pick-yields-bytes-leaf",
      "spec": "SPEC-5 §2.1/§5 + D12 (a bytes target renders as the { mime, value } View leaf; its canonical CBOR is exactly the target's)",
      "note": "icon pick byTimestamp desc → C's wasm leaf; leafCanonicalHex pins the leaf bytes themselves",
      "term": {
        "op": "resolve",
        "schema": {
          "props": {
            "icon": {
              "pick": {
                "order": {
                  "byTimestamp": "desc"
                }
              }
            }
          },
          "default": {
            "merge": "count"
          }
        },
        "in": {
          "op": "fix",
          "schema": "LogoRaw",
          "entity": "media:logo"
        }
      },
      "leafProp": "icon",
      "leafCanonicalHex": "a2646d696d65706170706c69636174696f6e2f7761736d6576616c75654889504e470d0a1a0a",
      "expectedView": {
        "icon": {
          "mime": "application/wasm",
          "value": "iVBORw0KGgo"
        },
        "weight": 3,
        "stamp": 2
      },
      "expectedCanonicalHex": "a36469636f6ea2646d696d65706170706c69636174696f6e2f7761736d6576616c75654889504e470d0a1a0a657374616d70f9400066776569676874f94200"
    },
